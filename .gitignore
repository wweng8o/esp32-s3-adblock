# PlatformIO build output
.pio/
.vscode/

# macOS metadata
.DS_Store
._*

# VS Code workspace file
*.code-workspace

# Generated blocklist (build it with tools/build_blocklist.py)
data/blocklist.bin

# WiFi credentials (copy src/secrets.example.h -> src/secrets.h)
src/secrets.h

# Backups / scratch
*.bak
*.orig

# Readable domain list (generated by --domains-out)
/blocklist.txt

# Prebuilt flash images and the web-installer manifest: produced by CI and
# attached to a GitHub release, never committed.
docs/*.bin
docs/manifest.json

# Local scratch builds kept outside the repository history
/.local-artifacts/
